{
  "name": "zaly",
  "version": "0.3.2",
  "private": true,
  "description": "Hackable terminal coding agent.",
  "homepage": "https://zaly.dev",
  "bugs": {
    "url": "https://github.com/folke/zaly/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/folke/zaly"
  },
  "workspaces": [
    "packages/*",
    "plugins"
  ],
  "type": "module",
  "scripts": {
    "api": "z api",
    "api:check": "z api --check",
    "build": "z build",
    "docs:build": "bun docs:generate && vitepress build docs",
    "docs:dev": "bun docs:generate && vitepress dev docs",
    "docs:generate": "bun packages/dev/src/docs.ts",
    "docs:preview": "vitepress preview docs",
    "fmt": "z fmt",
    "knip": "knip",
    "lint": "z lint",
    "models": "bun run --cwd 'packages/ai' models",
    "out": "bun outdated; bun outdated --filter '*'",
    "pkg": "bun --workspaces install",
    "publish": "z publish",
    "test": "z test --bun",
    "test:live": "LIVE=1 bun test live",
    "up": "bun z update"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.1.0",
    "@zaly/dev": "workspace:*",
    "asciinema-player": "^3.18.0",
    "knip": "^6.44.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "7.1.0-beta",
    "vitepress": "^2.0.0-alpha.21",
    "vitepress-plugin-group-icons": "^1.8.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@types/markdown-it": "14.1.2"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=22.18.0"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
