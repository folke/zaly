{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {
    "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
  },
  "definitions": {
    "Color<false,false>": {
      "description": "Hex color or theme slot. Hex colors and theme slots may have an integer +/- lightness adjustment.",
      "pattern": "^(?:(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|accent|bg|border|borderTitle|code|codeTitle|comment|delim|diffAdd|diffAddNum|diffContext|diffContextNum|diffDel|diffDelNum|divider|error|fg|gutter|highlight|info|mdBold|mdCode|mdCodeBlock|mdCodeBlockTitle|mdHeading|mdHeading1|mdHeading2|mdHeading3|mdHeading4|mdHeading5|mdHeading6|mdHr|mdItalic|mdLink|mdListBullet|mdListChecked|mdListUnchecked|mdMath|mdQuote|mdStrikethrough|mdTable|mdTableHeader|muted|optionActive|optionDesc|optionName|overlay|primary|prompt|quiet|selection|success|syntaxBoolean|syntaxBracket|syntaxConstant|syntaxDelimiter|syntaxField|syntaxFunction|syntaxNumber|syntaxSpecial|syntaxString|title|ui|warn)(?:[+-][0-9]+)?)$",
      "type": "string"
    },
    "Color<false>": {
      "description": "Hex color or theme slot, or inherit. Hex colors and theme slots may have an integer +/- lightness adjustment.",
      "pattern": "^(?:(?:#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|accent|bg|border|borderTitle|code|codeTitle|comment|delim|diffAdd|diffAddNum|diffContext|diffContextNum|diffDel|diffDelNum|divider|error|fg|gutter|highlight|info|mdBold|mdCode|mdCodeBlock|mdCodeBlockTitle|mdHeading|mdHeading1|mdHeading2|mdHeading3|mdHeading4|mdHeading5|mdHeading6|mdHr|mdItalic|mdLink|mdListBullet|mdListChecked|mdListUnchecked|mdMath|mdQuote|mdStrikethrough|mdTable|mdTableHeader|muted|optionActive|optionDesc|optionName|overlay|primary|prompt|quiet|selection|success|syntaxBoolean|syntaxBracket|syntaxConstant|syntaxDelimiter|syntaxField|syntaxFunction|syntaxNumber|syntaxSpecial|syntaxString|title|ui|warn)(?:[+-][0-9]+)?|inherit)$",
      "type": "string"
    },
    "ShikiSelection": {
      "anyOf": [
        {
          "const": "auto",
          "type": "string"
        },
        {
          "$ref": "#/definitions/ShikiTheme"
        }
      ]
    },
    "ShikiTheme": {
      "enum": [
        "andromeeda",
        "aurora-x",
        "ayu-dark",
        "ayu-light",
        "ayu-mirage",
        "catppuccin-frappe",
        "catppuccin-latte",
        "catppuccin-macchiato",
        "catppuccin-mocha",
        "dark-plus",
        "dracula",
        "dracula-soft",
        "everforest-dark",
        "everforest-light",
        "github-dark",
        "github-dark-default",
        "github-dark-dimmed",
        "github-dark-high-contrast",
        "github-light",
        "github-light-default",
        "github-light-high-contrast",
        "gruvbox-dark-hard",
        "gruvbox-dark-medium",
        "gruvbox-dark-soft",
        "gruvbox-light-hard",
        "gruvbox-light-medium",
        "gruvbox-light-soft",
        "horizon",
        "horizon-bright",
        "houston",
        "kanagawa-dragon",
        "kanagawa-lotus",
        "kanagawa-wave",
        "laserwave",
        "light-plus",
        "material-theme",
        "material-theme-darker",
        "material-theme-lighter",
        "material-theme-ocean",
        "material-theme-palenight",
        "min-dark",
        "min-light",
        "monokai",
        "night-owl",
        "night-owl-light",
        "nord",
        "one-dark-pro",
        "one-light",
        "plastic",
        "poimandres",
        "red",
        "rose-pine",
        "rose-pine-dawn",
        "rose-pine-moon",
        "slack-dark",
        "slack-ochin",
        "snazzy-light",
        "solarized-dark",
        "solarized-light",
        "synthwave-84",
        "tokyo-night",
        "vesper",
        "vitesse-black",
        "vitesse-dark",
        "vitesse-light"
      ],
      "type": "string"
    },
    "ThemeStyle<false>": {
      "additionalProperties": false,
      "description": "Simplify a type by flattening its properties.",
      "properties": {
        "bg": {
          "$ref": "#/definitions/Color%3Cfalse%3E"
        },
        "bold": {
          "type": "boolean"
        },
        "dim": {
          "type": "boolean"
        },
        "fg": {
          "$ref": "#/definitions/Color%3Cfalse%3E"
        },
        "inverse": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "strikethrough": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ThemeValue<false>": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThemeStyle%3Cfalse%3E"
        },
        {
          "$ref": "#/definitions/Color%3Cfalse%3E"
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "accent": {
      "$ref": "#/definitions/Color%3Cfalse%3E",
      "description": "Secondary accent — distinct hue from `primary`."
    },
    "appearance": {
      "description": "Dark/light appearance, inferred from bg when omitted in a theme file.",
      "enum": [
        "dark",
        "light"
      ],
      "type": "string"
    },
    "bg": {
      "$ref": "#/definitions/Color%3Cfalse%2Cfalse%3E"
    },
    "border": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Structural border around panels, boxes, tables."
    },
    "borderTitle": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Title text inside a bordered region (slightly stronger than `border`)."
    },
    "code": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Code-block surface (bg + optional fg). Default for `mdCodeBlock`."
    },
    "codeTitle": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Title above a code block (e.g. file path)."
    },
    "comment": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Editor-comment tier — soft, often tinted. Used for code annotations, line-number labels, italic quotes."
    },
    "delim": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Structural separators — borders, dividers, gutter lines."
    },
    "diffAdd": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "diffAddNum": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "diffContext": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "diffContextNum": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "diffDel": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "diffDelNum": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "divider": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Separators between messages or sections."
    },
    "error": {
      "$ref": "#/definitions/Color%3Cfalse%3E"
    },
    "fg": {
      "$ref": "#/definitions/Color%3Cfalse%2Cfalse%3E"
    },
    "gutter": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Line-number column, diff markers."
    },
    "highlight": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Tinted region for emphasized content within the stream — user bubble bg, focused row, callout. Distinct from `code`, which is reserved for code-block bg."
    },
    "id": {
      "type": "string"
    },
    "info": {
      "$ref": "#/definitions/Color%3Cfalse%3E"
    },
    "mdBold": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdCode": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdCodeBlock": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdCodeBlockTitle": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdHeading": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdHeading1": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdHeading2": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdHeading3": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdHeading4": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdHeading5": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdHeading6": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdHr": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdItalic": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdLink": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdListBullet": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdListChecked": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdListUnchecked": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdMath": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdQuote": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdStrikethrough": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdTable": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "mdTableHeader": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "muted": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Secondary text — first tier of the quietness ladder (`muted` → `quiet` → `comment`). Slightly faded but readable; good for timestamps, captions, less-prominent labels."
    },
    "name": {
      "type": "string"
    },
    "optionActive": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Currently-highlighted entry."
    },
    "optionDesc": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "optionName": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "overlay": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Popup / modal surface. One tier above `ui`."
    },
    "primary": {
      "$ref": "#/definitions/Color%3Cfalse%3E",
      "description": "Brand / primary accent."
    },
    "prompt": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Main input-prompt styling."
    },
    "quiet": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "De-emphasized but still readable. Reasoning / thinking text, secondary annotations, hints."
    },
    "selection": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Highlighted text in inputs, lists, autocomplete."
    },
    "shiki": {
      "$ref": "#/definitions/ShikiSelection",
      "description": "Matching bundled Shiki theme. Unset or \"auto\" generates highlighting from the syntax slots."
    },
    "success": {
      "$ref": "#/definitions/Color%3Cfalse%3E"
    },
    "syntaxBoolean": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "syntaxBracket": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "syntaxConstant": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "syntaxDelimiter": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "syntaxField": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "syntaxFunction": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "syntaxNumber": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "syntaxSpecial": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "syntaxString": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E"
    },
    "title": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Section / panel titles. Typically `bold` + a fg color."
    },
    "ui": {
      "$ref": "#/definitions/ThemeValue%3Cfalse%3E",
      "description": "Default UI surface. Bottom of the stack."
    },
    "warn": {
      "$ref": "#/definitions/Color%3Cfalse%3E"
    }
  },
  "required": [
    "accent",
    "bg",
    "diffAdd",
    "diffDel",
    "error",
    "fg",
    "id",
    "info",
    "primary",
    "selection",
    "success",
    "syntaxBoolean",
    "syntaxConstant",
    "syntaxField",
    "syntaxFunction",
    "syntaxNumber",
    "syntaxSpecial",
    "syntaxString",
    "warn"
  ],
  "type": "object"
}
