{
  "$schema": "https://raw.githubusercontent.com/folke/zaly/main/packages/tui/assets/schemas/theme.schema.json",
  "id": "material-theme",
  "name": "Material Theme",
  "shiki": "material-theme",
  "bg": "#263238",
  "fg": "#eeffff",
  "primary": "#80cbc4",
  "accent": "#eeffff",
  "success": "#c3e88d",
  "info": "#89ddff",
  "warn": "#85754e",
  "error": "#7f4e54",
  "selection": {
    "bg": "#31454a"
  },
  "diffAdd": {
    "bg": "#324751"
  },
  "diffDel": {
    "bg": "#413f47"
  },
  "syntaxBoolean": {
    "fg": "#ff9cac"
