  "mdHeading4": {
    "bold": true,
    "fg": "#ffcb6b"
  },
  "mdHeading5": {
    "bold": true,
    "fg": "#ffcb6b"
  },
  "mdHeading6": {
    "bold": true,
    "fg": "#ffcb6b"
  },
  "mdBold": {
    "bold": true,
    "fg": "#f07178"
