    "bold": true,
    "fg": "#0550ae"
  },
  "mdHeading3": {
    "bold": true,
    "fg": "#0550ae"
  },
  "mdHeading4": {
    "bold": true,
    "fg": "#0550ae"
  },
  "mdHeading5": {
    "bold": true,
    "fg": "#0550ae"
  },
  "mdHeading6": {
    "bold": true,
    "fg": "#0550ae"
  },
  "mdBold": {
    "bold": true,
    "fg": "#1f2328"
  },
  "mdItalic": {
    "fg": "#1f2328",
