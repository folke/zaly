{
  "$schema": "https://raw.githubusercontent.com/folke/zaly/main/packages/tui/assets/schemas/theme.schema.json",
  "id": "github-light-default",
  "name": "GitHub Light Default",
  "shiki": "github-light-default",
  "bg": "#ffffff",
  "fg": "#1f2328",
  "primary": "#0969da",
  "accent": "#0969da",
  "success": "#116329",
  "info": "#1b7c83",
  "warn": "#4d2d00",
  "error": "#cf222e",
  "selection": {
    "bg": "#eff1f3"
  },
  "diffAdd": {
    "bg": "#e6faea"
  },
  "diffDel": {
    "bg": "#fff0ef"
