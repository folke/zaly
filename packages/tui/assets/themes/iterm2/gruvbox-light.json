{
  "$schema": "https://raw.githubusercontent.com/folke/zaly/main/packages/tui/assets/schemas/theme.schema.json",
  "id": "gruvbox-light",
  "name": "Gruvbox Light",
  "appearance": "light",
  "shiki": "auto",
  "muted": "#9c957f",
  "quiet": {
    "dim": true,
    "fg": "muted",
    "italic": true
  },
  "comment": {
    "fg": "muted",
    "italic": true
  },
  "title": {
    "bold": true,
    "fg": "primary"
  },
  "delim": "muted",
  "ui": {
    "bg": "bg-3"
  },
  "overlay": {
    "bg": "ui"
  },
  "highlight": {
    "bg": "bg-3"
  },
  "divider": "fg-5",
  "gutter": "quiet",
  "prompt": "inherit",
  "border": "divider",
  "borderTitle": "title",
  "code": {
    "bg": "bg-2"
  },
  "codeTitle": "title",
  "syntaxDelimiter": "delim",
  "syntaxBracket": "delim",
  "mdBold": {
    "bold": true
  },
  "mdCode": {
    "bg": "highlight",
    "fg": "primary"
  },
  "mdCodeBlock": "code",
  "mdCodeBlockTitle": "title",
  "mdHeading1": "mdHeading",
  "mdHeading2": {
    "bold": true,
    "fg": "accent"
  },
  "mdHeading3": "mdHeading2",
  "mdHeading4": "mdHeading2",
  "mdHeading5": "mdHeading2",
  "mdHeading6": "mdHeading2",
  "mdHeading": "title",
  "mdHr": "accent",
  "mdItalic": {
    "italic": true
  },
  "mdLink": {
    "fg": "primary",
    "underline": true
  },
  "mdListBullet": "accent",
  "mdListChecked": "primary",
  "mdListUnchecked": "primary",
  "mdQuote": "muted",
  "mdStrikethrough": {
    "strikethrough": true
  },
  "mdTable": "accent",
  "mdTableHeader": "title",
  "optionActive": "selection",
  "optionDesc": "muted",
  "optionName": "primary",
  "diffContext": {
    "bg": "code"
  },
  "diffAddNum": {
    "bg": "diffAdd-10"
  },
  "diffDelNum": {
    "bg": "diffDel-10"
  },
  "diffContextNum": {
    "bg": "diffContext-10"
  },
  "primary": "#458588",
  "accent": "#8f3f71",
  "bg": "#fbf1c7",
  "fg": "#3c3836",
  "selection": {
    "bg": "#3c3836",
    "fg": "#fbf1c7"
  },
  "success": "#98971a",
  "info": "#689d6a",
  "warn": "#d79921",
  "error": "#cc241d",
  "syntaxNumber": "#076678",
  "syntaxString": "#98971a",
  "syntaxBoolean": "#d79921",
  "syntaxFunction": "#458588",
  "syntaxField": "fg",
  "syntaxConstant": "#b16286",
  "syntaxSpecial": "#cc241d",
  "black": "#fbf1c7",
  "red": "#cc241d",
  "green": "#98971a",
  "yellow": "#d79921",
  "blue": "#458588",
  "magenta": "#b16286",
  "cyan": "#689d6a",
  "white": "#7c6f64",
  "brightBlack": "#928374",
  "brightRed": "#9d0006",
  "brightGreen": "#79740e",
  "brightYellow": "#b57614",
  "brightBlue": "#076678",
  "brightMagenta": "#8f3f71",
  "brightCyan": "#427b58",
  "brightWhite": "#3c3836",
  "brightGray": "#928374",
  "brightGrey": "#928374",
  "gray": "#928374",
  "grey": "#928374",
  "diffAdd": {
    "bg": "#e7dfa4",
    "fg": "success"
  },
  "diffDel": {
    "bg": "#f2c8a5",
    "fg": "error"
