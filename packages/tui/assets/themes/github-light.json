{
  "$schema": "https://raw.githubusercontent.com/folke/zaly/main/packages/tui/assets/schemas/theme.schema.json",
  "id": "github-light",
  "name": "GitHub Light",
  "shiki": "github-light",
  "bg": "#ffffff",
  "fg": "#24292e",
  "primary": "#0366d6",
  "accent": "#005cc5",
  "success": "#28a745",
  "info": "#1b7c83",
  "warn": "#f9c513",
  "error": "#cb2431",
  "selection": {
    "bg": "#dae9f9"
  },
  "diffAdd": {
    "bg": "#e4f9e9"
  },
  "diffDel": {
    "bg": "#fae5e7"
  },
  "syntaxBoolean": {
    "fg": "#005cc5"
  },
  "syntaxBracket": {
    "fg": "#24292e"
  },
  "syntaxConstant": {
    "fg": "#005cc5"
  },
  "syntaxDelimiter": {
    "fg": "#24292e"
  },
  "syntaxField": {
    "fg": "#24292e"
  },
  "syntaxFunction": {
    "fg": "#6f42c1"
  },
  "syntaxNumber": {
    "fg": "#005cc5"
  },
  "syntaxSpecial": {
    "fg": "#d73a49"
  },
  "syntaxString": {
    "fg": "#032f62"
  },
  "border": "#e1e4e8",
  "comment": {
    "fg": "#6a737d"
  },
  "mdHeading": {
    "bold": true,
    "fg": "#005cc5"
  },
  "mdHeading1": {
    "bold": true,
    "fg": "#005cc5"
  },
  "mdHeading2": {
    "bold": true,
    "fg": "#005cc5"
  },
  "mdHeading3": {
    "bold": true,
    "fg": "#005cc5"
  },
  "mdHeading4": {
    "bold": true,
    "fg": "#005cc5"
  },
  "mdHeading5": {
    "bold": true,
    "fg": "#005cc5"
  },
  "mdHeading6": {
    "bold": true,
    "fg": "#005cc5"
  },
  "mdBold": {
    "bold": true,
    "fg": "#24292e"
  },
  "mdItalic": {
    "fg": "#24292e",
    "italic": true
  },
  "mdStrikethrough": {
    "fg": "#24292e",
    "strikethrough": true
  },
  "mdLink": {
    "fg": "#032f62",
    "underline": true
  },
  "mdQuote": {
    "fg": "#22863a"
  },
  "mdListBullet": {
    "fg": "#e36209"
  },
  "mdHr": {
    "bold": true,
    "fg": "#005cc5"
  }
}
