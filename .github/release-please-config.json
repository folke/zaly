{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "separate-pull-requests": true,
  "prerelease": false,
  "changelog-sections": [
    { "type": "feat", "section": "🚀 Enhancements" },
    { "type": "fix", "section": "🩹 Fixes" },
    { "type": "perf", "section": "🔥 Performance" },
    { "type": "refactor", "section": "💅 Refactors" },
    { "type": "types", "section": "🌊 Types" },
    { "type": "style", "section": "🎨 Styles" },
    { "type": "revert", "section": "⏪ Reverts" },
    { "type": "docs", "section": "📖 Documentation" },
    { "type": "test", "section": "✅ Tests" },
    { "type": "build", "section": "📦 Build" },
    { "type": "ci", "section": "🤖 CI" },
    { "type": "chore", "section": "🏡 Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "extra-files": [
        { "type": "json", "path": "packages/agent/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/ai/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/cli/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/config/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/plugin/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/shared/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/tui/package.json", "jsonpath": "$.version" }
      ]
    }
  },
  "bootstrap-sha": "297a711069ff4afecc7783ae4cd463391effa806",
  "include-component-in-tag": false,
  "include-v-in-tag": true
}
